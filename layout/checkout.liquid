    {{ tracking_code }}
    
    <script>
      var hide = false;
      var hidePP = false;
      {% for item in checkout.line_items %}
        {% for tag in item.product.tags %}
      		{% if tag == "no-affirm" %}
      			hide = true;
      			hidePP = true;
      		{% endif %}
      	{% endfor %}
      {% endfor %}
      {% if checkout.total_price < 25000 %}
      	hide = true;
      {% endif %}
      if ( hidePP ) {
      	var pp = document.querySelector('[data-select-gateway="6746084"]');
        if ( pp ) {
	        pp.remove();
        }
      }
      if ( hide ) {
      	var affirm = document.querySelector('[data-select-gateway="33726955585"]');
        if ( affirm ) {
	        affirm.remove();
        }
      }
      
      
      var mutationObserver = new MutationObserver(function(mutations) {
 		mutations.forEach(function(mutation) {
    		//console.log(mutation);
          	if ( hidePP ) {
     		 	var paypal = document.querySelector('iframe.paypalLight');
        		if ( paypal ) {
	        		paypal.parentElement.remove();
        		}
      		}
  		});
	  });
      mutationObserver.observe(document.documentElement, {
        attributes: true,
        characterData: true,
        childList: true,
        subtree: true,
        attributeOldValue: true,
        characterDataOldValue: true
      });
      
      
      
    </script>
    
    <script>
      var jquery = null;

      if (window.jQuery) {
        jquery = window.jQuery;
      } else if (window.Checkout && window.Checkout.$) {
        jquery = window.Checkout.$;
      }
      
      jquery ( document ).ready(function() {  
        jquery('button.order-summary-toggle--show').click();

        {% comment %} console.log('checkout');         {% endcomment %}
        var show = false;  
        {% for item in checkout.line_items %}
          {% for tag in item.product.tags %}
              {% comment %} console.log({{ tag | json }}); {% endcomment %}
              {% if tag == "no-affirm" %}
                  show = true;
              {% endif %}
          {% endfor %}
        {% endfor %}  
		
        //console.log(show);  
        //04-30 - always show the opt in box
        show = true;
        
        if (show == true) {

          var optinmarkup = '<div style="width: 100%; padding: 5px;" class="fieldset-description"><div class="section__content"><div class="checkbox-wrapper"><div class="checkbox__input"><input class="input-checkbox" type="checkbox" value="1" name="attributes[tos_agree]" id="checkout_tos_agree" checked></div><label class="checkbox__label" for="checkout_tos_agree">I agree that I am at least 18 years old and agree to the <a aria-haspopup="dialog" data-modal="policy-terms-of-service" data-title-text="Terms of service" data-close-text="Close" data-iframe="true" href="/2486216/policies/terms-of-service.html?locale=en">Terms of service</a>.</label></div></div></div>';

          jquery('.step[data-step="payment_method"] .step__sections .section').last().append(optinmarkup);

          
          jquery("#checkout_tos_agree").attr('checked', !jquery("#continue_button").disabled);
          jquery("#checkout_tos_agree").click(function(){   
            jquery("#continue_button").attr('disabled', !this.checked);
          });
        }
        
        //hide login for now
        jquery( "a[data-trekkie-id='have_an_account_login_link']" ).parent().hide();
        
      });

    </script>

    <style>
    .step__footer__continue-btn:disabled {
      cursor: not-allowed;
      opacity: .5;
    }
    .step__footer__previous-link {
	  display:none;
    }
    </style>

