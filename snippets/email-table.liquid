{%- style -%}
  table:not([class]) td,
  table:not([class]) th {
    border: none;
  }
  table:not([class]) {
    box-shadow: none;
  }
  .center {
    text-align: -webkit-center;
  }
{%- endstyle -%}

<div style="padding: 20px 0 20px; margin: 0 auto; text-align: center;">
  <button
    id="copyMarkupButton"
    class="product-form__submit button button--full-width button--secondary"
    style="width: auto; margin: 0 auto; text-align: center;"
  >
    Copy Markup
  </button>
</div>
<script>
  var copyMarkupButton = document.getElementById('copyMarkupButton');
  copyMarkupButton.addEventListener('click', function () {
    copyMarkup();
    function copyMarkup() {
      // Get the text field
      var copyHtml = document.getElementById('emailMarkup').innerHTML;

      // Copy the text inside the text field
      navigator.clipboard.writeText(copyHtml);

      // Alert the copied text
      alert('Copied markup to clipboard.');
    }
  });
</script>

<div id="emailMarkup">
  <!-- begin uncrate supply -->
  <style>
    .price-simple .nbsp {
      display: inline-block;
      width: 8px;
    }
    .price-simple {
      white-space: nowrap;
    }
  </style>
  <table
    bgcolor="#FFFFFF"
    cellpadding="0"
    cellspacing="0"
    class="nl-container"
    role="presentation"
    style="table-layout: fixed; vertical-align: top; min-width: 320px; Margin: 0 auto; border-spacing: 0; border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #FFFFFF; width: 100%;"
    valign="top"
    width="100%"
  >
    <tbody>
      <tr>
        <td>
          <table
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="background-color:#FFFFFF;background-image:none;background-repeat:repeat;background-position:left top;background-attachment:scroll;table-layout: fixed; vertical-align: top; min-width: 320px; Margin: 20px auto 0 auto; border-spacing: 0; border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: 100%;"
          >
            <tr>
              <td
                align="center"
                style="padding-top:0;padding-bottom:20px;padding-right:5px;padding-left:5px;"
              >
                <table
                  cellpadding="0"
                  cellspacing="0"
                  width="600"
                  class="respond"
                  style="table-layout: fixed;"
                >
                  {%- for product in products -%}
                    {% assign mod = forloop.index | modulo: 2 %}
                    {% if mod != 0 %}
                      <tr style="vertical-align: top;" valign="top">
                    {%- endif -%}

                    <td style="padding-top:3px;padding-bottom:0px;padding-right:5px;padding-left:5px;text-align:center;width:50%;max-width:50%;">
                      <div
                        align="center"
                        class="img-container center autowidth"
                        style="padding-right: 0px;padding-left: 0px;"
                      >
                        <!--[if mso]>
                          <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr style="line-height:0px"><td style="padding-right: 0px;padding-left: 0px;" align="center">
                        <![endif]-->
                        <a href="{{ shop.secure_url }}{{ product.url }}"
                          ><img
                            align="center"
                            alt="{{ product.title }}"
                            border="0"
                            class="center autowidth"
                            src="https:{{ product.featured_media.src | image_url: width: 480 }}"
                            style="text-decoration: none; -ms-interpolation-mode: bicubic; border: 0; height: auto; width: 100%; max-width: 200px; display: block;"
                            title="{{ product.title }}"
                            width="200"
                        ></a>
                        <!--[if mso]> </td></tr></table> <![endif]-->
                      </div>
                      <!--[if mso]>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding-right: 10px; padding-left: 10px; padding-top: 10px; padding-bottom: 10px; font-family: Arial, sans-serif">
                      <![endif]-->

                      <div style="color:#555555;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;line-height:1.2;padding-top:10px;padding-right:10px;padding-bottom:10px;padding-left:10px;">
                        <p style="color:#000;text-transform:uppercase;font-family:HelveticaNeue,'Helvetica Neue',Helvetica,Arial,sans-serif;display:block;font-size:12px;letter-spacing:.5px;line-height:1.5;font-weight:700;width:100%;text-align:center;text-decoration:none;padding:0px 5px;Margin:0;">
                          <a
                            href="{{ product.url }}"
                            style="color:#000;text-transform:uppercase;text-decoration:none;text-wrap:balance;text-wrap:pretty;"
                          >
                            {%- render 'card-title-price', product: product, price_class: '' -%}
                          </a>
                        </p>
                      </div>
                    </td>

                    {% if mod == 0 %}
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
  <!-- end uncrate supply email -->
</div>
