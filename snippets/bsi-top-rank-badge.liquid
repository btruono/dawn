{% comment %}
************************************************************************
* NOTE: This file is generated by the Best Sellers app and should
* not be manually modified.
*
* Any changes made to this file will be overwritten the next time you save
* them within the Best Sellers settings.
*
* Best Sellers: https://apps.shopify.com/best-sellers
************************************************************************
{% endcomment %}
{% assign bsi_rank_collection = product.metafields.bsi.best-seller-ranks | split: ';' | first | split: ':' %}
{% assign bsi_rank = bsi_rank_collection[0] | plus:0 %}
{% assign bsi_collection = collections[bsi_rank_collection[1]] %}
{% if bsi_collection != empty and bsi_rank <= 5 %}
  <div class="bsi-top-rank-badge">
    <div class="bsi-top-rank-badge-banner" style="display: inline-block;box-sizing: border-box;color: #FFFFFF;background-color: #000000;padding: 0 10px;position: relative;margin-right: 12px;height: 25px"> #{{bsi_rank}} Best Seller
    <span class="bsi-top-rank-badge-arrow" style="border-top: 12px solid #000000;border-bottom: 13px solid #000000;border-right: 13px solid transparent;position: absolute;right: -13px;top: 0"></span></div>
    in <a href="{{ bsi_collection.url }}">{{ bsi_collection.title }}</a>
  </div>

  <style>
    .bsi-top-rank-badge {
      display: flex;
      gap: 0.15em;
      font-size: 12px;
      text-transform: uppercase;
      font-weight: bold;
      letter-spacing: 0.04166667em;
      line-height: 25px;
      margin-bottom: 5px;
    }

    .bsi-top-rank-badge-banner {
      line-height: 25px;
    }
  </style>
{% endif %}
